// Esquema de la base de datos (PostgreSQL en Supabase).
// Las migraciones viven en prisma/migrations como SQL y se aplican a mano en el
// SQL Editor de Supabase (primero dev, luego prod). Ver docs/MIGRACIONES.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  MODERATOR
  ADMIN
}

/// Usuario. Solo entra con Discord: guardamos su ID, nombre visible y avatar.
model User {
  id                String            @id
  name              String
  /// Better Auth exige un correo; como no pedimos el ámbito `email`, se guarda
  /// uno ficticio derivado del ID de Discord (`<id>@discord.invalid`).
  email             String            @unique
  emailVerified     Boolean           @default(false) @map("email_verified")
  image             String?
  discordId         String            @unique @map("discord_id")
  role              Role              @default(PLAYER)
  /// Pertenencia al servidor de Discord de la comunidad (si se configura DISCORD_GUILD_ID).
  /// null = no comprobada. Se actualiza en cada inicio de sesión.
  guildMember       Boolean?          @map("guild_member")
  guildCheckedAt    DateTime?         @map("guild_checked_at")
  /// Puede ver la documentación privada del proyecto (lo activa un administrador por configuración).
  projectDocsAccess Boolean           @default(false) @map("project_docs_access")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  sessions          Session[]
  accounts          Account[]
  registrations     Registration[]
  achievements      UserAchievement[]
  reportedMatches   Match[]           @relation("MatchReporter")

  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

/// Cuenta de Discord vinculada. No guardamos los tokens de Discord (se vacían al crearla).
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Valores temporales del inicio de sesión (estado de OAuth).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

/// Migraciones aplicadas a mano en el SQL Editor (cada archivo de migración inserta su nombre).
model AppMigration {
  name      String   @id
  appliedAt DateTime @default(now()) @map("applied_at")

  @@map("app_migrations")
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  FINISHED
}

/// Una edición de la liga (p. ej. «VI Liga Puente 3»).
model Tournament {
  id                   String           @id @default(cuid())
  slug                 String           @unique
  name                 String
  description          String?
  /// Colección del torneo, solo como texto (p. ej. «HMW» y «Homeworlds»). Sin logos oficiales.
  collectionCode       String?          @map("collection_code")
  collectionName       String?          @map("collection_name")
  /// Enlace a las bases de la competición.
  rulesUrl             String?          @map("rules_url")
  startsOn             DateTime?        @map("starts_on") @db.Date
  /// Plazo general para jugar los partidos de la liguilla.
  matchDeadlineOn      DateTime?        @map("match_deadline_on") @db.Date
  status               TournamentStatus @default(DRAFT)
  registrationOpen     Boolean          @default(false) @map("registration_open")
  /// Ventana de inscripción (opcional). Se guarda en UTC; se muestra en hora de España.
  registrationOpensAt  DateTime?        @map("registration_opens_at")
  registrationClosesAt DateTime?        @map("registration_closes_at")
  promotions           Int              @default(1)
  relegations          Int              @default(1)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  registrations        Registration[]
  groups               Group[]
  brackets             Bracket[]
  /// Usuario al que ya se le sumó la Liga Puente 3 por ganar Legendaria (evita sumarla dos veces).
  leagueAwardUserId    String?          @map("league_award_user_id")

  @@map("tournaments")
}

enum PreviousParticipation {
  LAST_EDITION
  FIRST_TIME
  EARLIER_EDITIONS
}

/// Inscripción de un jugador en un torneo (respuestas del formulario).
model Registration {
  id                    String                @id @default(cuid())
  tournamentId          String                @map("tournament_id")
  tournament            Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId                String                @map("user_id")
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousParticipation PreviousParticipation @map("previous_participation")
  /// Solo si es su primera vez: ¿ha ganado un PQ, Sector o Regional?
  firstTimeBigWin       Boolean?              @map("first_time_big_win")
  streamingConsent      Boolean               @map("streaming_consent")
  /// Ciudad y país: solo los ven los administradores.
  city                  String
  country               String
  rulesAcceptedAt       DateTime              @map("rules_accepted_at")
  /// División asignada por un administrador (null = sin asignar).
  division              DivisionTier?
  groupMember           GroupMember?
  matchesAsA            Match[]               @relation("MatchPlayerA")
  matchesAsB            Match[]               @relation("MatchPlayerB")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  @@unique([tournamentId, userId])
  @@index([userId])
  @@map("registrations")
}

enum AchievementType {
  PQ
  SECTOR
  REGIONAL
  GALACTIC
  LIGA_PUENTE3
}

/// Logros que cada jugador indica en su perfil (veces que ha ganado cada cosa).
model UserAchievement {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AchievementType
  count     Int             @default(1)
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([userId, type])
  @@map("user_achievements")
}

/// Divisiones, de la más alta a la más baja. La «N» (provisional) se añadirá más adelante.
enum DivisionTier {
  LEGENDARY
  RARE
  UNCOMMON
  COMMON
}

/// Grupo de una división (p. ej. «Rara 2»). Liguilla de todos contra todos.
model Group {
  id           String        @id @default(cuid())
  tournamentId String        @map("tournament_id")
  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  division     DivisionTier
  number       Int
  createdAt    DateTime      @default(now()) @map("created_at")
  members      GroupMember[]
  matches      Match[]

  @@unique([tournamentId, division, number])
  @@map("groups")
}

/// Jugador (inscripción) dentro de un grupo. Una inscripción solo puede estar en un grupo.
model GroupMember {
  id             String       @id @default(cuid())
  groupId        String       @map("group_id")
  group          Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  registrationId String       @unique @map("registration_id")
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([groupId])
  @@map("group_members")
}

enum MatchStatus {
  PENDING
  PLAYED
  NOT_PLAYED
}

/// Partido de liguilla al mejor de 3. Si un jugador borra su cuenta, su lado queda a null
/// y el resultado se conserva para no alterar la clasificación del resto.
model Match {
  id           String        @id @default(cuid())
  groupId      String        @map("group_id")
  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  playerAId    String?       @map("player_a_id")
  playerA      Registration? @relation("MatchPlayerA", fields: [playerAId], references: [id], onDelete: SetNull)
  playerBId    String?       @map("player_b_id")
  playerB      Registration? @relation("MatchPlayerB", fields: [playerBId], references: [id], onDelete: SetNull)
  status       MatchStatus   @default(PENDING)
  gamesA       Int?          @map("games_a")
  gamesB       Int?          @map("games_b")
  reportedById String?       @map("reported_by_id")
  reportedBy   User?         @relation("MatchReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  reportedAt   DateTime?     @map("reported_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([groupId, playerAId, playerBId])
  @@index([playerAId])
  @@index([playerBId])
  @@map("matches")
}

/// Documentación privada del proyecto (servicios, traspaso, claves, migraciones).
/// Está en la base de datos y no en el repositorio, que es público.
model ProjectDoc {
  slug        String   @id
  title       String
  body        String
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@map("project_docs")
}

/// Cuadro de eliminatorias de una división. La definición (quién juega y de dónde
/// sale cada plaza) la crea src/lib/bracket.ts y se guarda tal cual.
model Bracket {
  id           String          @id @default(cuid())
  tournamentId String          @map("tournament_id")
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  division     DivisionTier
  definition   Json
  createdAt    DateTime        @default(now()) @map("created_at")
  results      BracketResult[]

  @@unique([tournamentId, division])
  @@map("brackets")
}

/// Resultado de un partido del cuadro, guardado con los jugadores que lo jugaron
/// (IDs de inscripción, sin clave ajena: si alguien borra su cuenta, el resultado se conserva).
model BracketResult {
  id           String   @id @default(cuid())
  bracketId    String   @map("bracket_id")
  bracket      Bracket  @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  code         String
  playerAId    String   @map("player_a_id")
  playerBId    String   @map("player_b_id")
  gamesA       Int      @map("games_a")
  gamesB       Int      @map("games_b")
  reportedById String?  @map("reported_by_id")
  reportedAt   DateTime @default(now()) @map("reported_at")

  @@unique([bracketId, code])
  @@map("bracket_results")
}
