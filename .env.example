# =============================================================================
# LigaPuente3 — variables de entorno
#
# Copia este archivo a `.env.local` para desarrollo (NUNCA se sube al repo) y
# rellena los valores del proyecto de Supabase `ligapuente3-dev`.
# En Vercel se configuran en Settings → Environment Variables.
# Todo lo que depende de quién gestione la web va aquí: traspasar = cambiar
# estas variables, no el código. Ver docs/TRANSFERENCIA.md.
# =============================================================================

# --- Identidad del sitio (públicas, sin secretos) ----------------------------

# Nombre que se muestra en la web. Por defecto: LigaPuente3
SITE_NAME=LigaPuente3

# Nombre de la comunidad organizadora. Por defecto: puente3
COMMUNITY_NAME=puente3

# URL pública, sin barra final. En Vercel, si falta, se usa el dominio de
# producción del proyecto; en local, http://localhost:3100.
SITE_URL=http://localhost:3100

# Correo de contacto para privacidad y soporte (RGPD). Opcional: si falta, la
# web remite a los organizadores en su servidor de Discord.
CONTACT_EMAIL=

# Responsable del tratamiento de datos (RGPD). Opcional: si falta, se muestra
# "los organizadores de la liga de <COMMUNITY_NAME>".
LEGAL_CONTROLLER_NAME=

# Enlace al código fuente que se muestra en el pie. Opcional.
REPO_URL=https://github.com/LigaPuente3/ligapuente3

# --- Base de datos (Supabase) -------------------------------------------------
# Supabase → proyecto → botón «Connect» (arriba) → pestaña «ORMs» o «Connection String».
# Sustituye [YOUR-PASSWORD] por la contraseña del proyecto. SECRETAS.
# En local: proyecto ligapuente3-dev. En Vercel Production: ligapuente3-prod.

# Pooler en modo transacción («Transaction pooler», puerto 6543): la usa la app.
DATABASE_URL=

# Pooler en modo sesión («Session pooler», puerto 5432): solo para herramientas
# de migración de Prisma. Nunca la de producción en un equipo local.
DIRECT_URL=

# --- Inicio de sesión (Better Auth + Discord) --------------------------------

# Secreto aleatorio de al menos 32 caracteres, DISTINTO en local y en producción.
# Para generarlo: npx @better-auth/cli secret   (o cualquier generador de contraseñas largas)
BETTER_AUTH_SECRET=

# URL base de la web: http://localhost:3100 en local; https://ligapuente3.vercel.app en producción.
BETTER_AUTH_URL=http://localhost:3100

# Discord Developer Portal → aplicación LigaPuente3 → OAuth2.
# El ID de cliente no es secreto; el secreto del cliente SÍ.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# IDs de Discord con rol ADMIN, separados por comas. No son secretos.
ADMIN_DISCORD_IDS=

# Opcional. ID del servidor de Discord de la comunidad: si se pone, solo sus
# miembros pueden inscribirse en torneos (se añade el ámbito guilds.members.read
# y se comprueba al iniciar sesión). Vacío = no se exige. No es secreto.
# En Discord: Modo desarrollador → clic derecho en el servidor → Copiar ID del servidor.
DISCORD_GUILD_ID=

# Opcional. Enlace de invitación al servidor, que se muestra a quien no es miembro.
DISCORD_GUILD_INVITE_URL=

# --- Mantenimiento -------------------------------------------------------------

# Secreto que Vercel Cron envía a /api/cron/keepalive (evita la pausa de Supabase).
# Solo hace falta en Vercel Production. Mínimo 16 caracteres. SECRETO.
CRON_SECRET=
